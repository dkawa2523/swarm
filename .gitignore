!Model/positive_column_1d.mph
!Model/positive_column_1d_boltzmann.mph
!Model/boltzmann_argon.mph
Model/work/
Model/logs/
Model/generated/
!model/README.md
!model/maps/
!model/maps/*.yaml
!Model/README.md
!Model/maps/
!Model/maps/*.yaml

# GEC generated models and compiled/generated artifacts.
